# Base URL for the Dream Portal web application
BASE_URL=https://arjitnigam.github.io/myDreams

# OpenAI API Key for AI-driven dream classification
# (Optional: If omitted, the framework automatically uses the built-in offline heuristic classifier)
OPENAI_API_KEY=

# OpenAI Model configuration (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
